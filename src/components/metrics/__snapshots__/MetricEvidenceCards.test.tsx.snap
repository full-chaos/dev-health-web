// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MetricEvidenceCards pinned behaviour (CHAOS-7705, before merging into MetricCard) > markup of a four-tile strip 1`] = `"<div data-testid="metric-tile-strip" data-columns="4" style="--cols: 4;" class="grid grid-cols-2 gap-px overflow-hidden rounded-(--radius-md) border border-(--card-stroke) bg-(--card-stroke) [&amp;>*]:rounded-none [&amp;>*]:border-0 lg:[grid-template-columns:repeat(var(--cols),minmax(0,1fr))]"><article class="group relative min-h-31 min-w-0 rounded-(--radius-md) border border-(--card-stroke) bg-card px-5 py-4.5 transition hover:-translate-y-1 hover:shadow-lg "><div class="flex items-center text-label-caps uppercase text-(--ink-muted)"><span>Up</span></div><p class="mt-2.5 text-[1.75rem] font-semibold leading-tight tabular-nums text-foreground">10%</p><div class="mt-2 text-xs text-(--ink-muted) max-w-[55%]"><span class="inline-flex items-center gap-1 text-[10px] normal-case tracking-normal text-(--positive)">↑ +12%</span><span aria-hidden="true"> · </span><button type="button" class="text-left text-(--accent-2) underline-offset-4 hover:underline">Open evidence</button></div><div class="absolute right-4 h-7.75 w-21.75 bottom-6.5"><div data-testid="sparkline"></div></div></article><article class="group relative min-h-31 min-w-0 rounded-(--radius-md) border border-(--card-stroke) bg-card px-5 py-4.5 transition hover:-translate-y-1 hover:shadow-lg "><div class="flex items-center text-label-caps uppercase text-(--ink-muted)"><span>Down</span></div><p class="mt-2.5 text-[1.75rem] font-semibold leading-tight tabular-nums text-foreground">5d</p><div class="mt-2 text-xs text-(--ink-muted) max-w-[55%]"><span class="inline-flex items-center gap-1 text-[10px] normal-case tracking-normal text-(--accent-negative)">↓ -7%</span><span aria-hidden="true"> · </span><button type="button" class="text-left text-(--accent-2) underline-offset-4 hover:underline">Open evidence</button></div><div class="absolute right-4 h-7.75 w-21.75 bottom-6.5"><div data-testid="sparkline"></div></div></article><article class="group relative min-h-31 min-w-0 rounded-(--radius-md) border border-(--card-stroke) bg-card px-5 py-4.5 transition hover:-translate-y-1 hover:shadow-lg "><div class="flex items-center text-label-caps uppercase text-(--ink-muted)"><span>Flat</span></div><p class="mt-2.5 text-[1.75rem] font-semibold leading-tight tabular-nums text-foreground">3h</p><div class="mt-2 text-xs text-(--ink-muted) max-w-[55%]"><span title="No change" class="inline-flex items-center gap-1 text-[10px] normal-case tracking-normal text-(--ink-muted)">· 0%</span><span aria-hidden="true"> · </span><button type="button" class="text-left text-(--accent-2) underline-offset-4 hover:underline">Open evidence</button></div><div class="absolute right-4 h-7.75 w-21.75 bottom-6.5"><div data-testid="sparkline"></div></div></article><article class="group relative min-h-31 min-w-0 rounded-(--radius-md) border border-(--card-stroke) bg-card px-5 py-4.5 transition hover:-translate-y-1 hover:shadow-lg "><div class="flex items-center text-label-caps uppercase text-(--ink-muted)"><span>NoSpark</span></div><p class="mt-2.5 text-[1.75rem] font-semibold leading-tight tabular-nums text-foreground">2</p><div class="mt-2 text-xs text-(--ink-muted) "><span class="inline-flex items-center gap-1 text-[10px] normal-case tracking-normal text-(--positive)">↑ +4%</span><span aria-hidden="true"> · </span><button type="button" class="text-left text-(--accent-2) underline-offset-4 hover:underline">Open evidence</button></div><div class="absolute right-4 h-7.75 w-21.75 bottom-6.5"><span title="Not enough data points to plot a trend yet" class="flex h-full items-center justify-end text-label-caps uppercase text-(--ink-muted)">No trend yet</span></div></article></div>"`;
