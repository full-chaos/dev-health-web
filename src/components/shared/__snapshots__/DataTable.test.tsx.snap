exports[`DataTable baseline (behaviour before the row-action and footer props) > markup of a full configuration (snapshot taken before the new props existed) 1`] = `"<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"><div class="flex flex-col gap-2 sm:flex-row sm:items-center"><form class="flex items-center gap-2"><input placeholder="Search" class="rounded-md border border-(--card-stroke) bg-(--card-60) px-2 py-1 text-sm text-foreground" type="search" value=""><button type="submit" class="rounded-md border border-(--card-stroke) px-2.5 py-1 text-xs font-medium text-foreground hover:bg-(--card-70)">Filter</button></form><span>tools</span></div><p class="text-sm text-(--ink-muted)">Page 1 of 2 (2 things)</p></div><div role="region" aria-label="Things" tabindex="0" class="overflow-x-auto rounded-2xl border border-(--card-stroke) bg-(--card-80)"><table class="w-full text-left text-sm"><thead class="border-b border-(--card-stroke) bg-(--card-70) text-(--ink-muted)"><tr><th class="px-4 py-3 font-medium">Name</th><th class="px-4 py-3 font-medium">Size</th></tr></thead><tbody class="divide-y divide-(--card-stroke)"><tr class="transition-colors hover:bg-(--card-70)"><td class="px-4 py-3">Alpha</td><td class="px-4 py-3">1</td></tr><tr class="transition-colors hover:bg-(--card-70)"><td class="px-4 py-3">Beta</td><td class="px-4 py-3">2</td></tr></tbody></table></div><div class="mt-4 flex justify-end gap-2"><button type="button" disabled="" class="rounded-md border border-(--card-stroke) px-3 py-1.5 text-sm disabled:opacity-50">Previous</button><button type="button" class="rounded-md border border-(--card-stroke) px-3 py-1.5 text-sm disabled:opacity-50">Next</button></div>"`;
