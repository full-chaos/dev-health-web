exports[`Monitoring views markup (snapshot taken before the restyle) > markup of the card for the neutral lens 1`] = `"<section class="rounded-3xl border border-(--card-stroke) bg-(--card-80) p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-xs uppercase tracking-[0.15em] text-(--ink-muted)">Monitoring views</p><p class="mt-1 text-sm text-(--ink-muted)">Tabs for steady trend monitoring.</p></div><a class="text-xs uppercase tracking-[0.2em] text-(--accent-2)" href="/metrics?tab=dora&amp;f=…&amp;role=ic">Open metrics</a></div><div class="mt-4 grid gap-3 md:grid-cols-2"><a class="group rounded-2xl border border-(--card-stroke) bg-(--card) px-4 py-3 transition hover:-translate-y-1" href="/metrics?tab=flow&amp;f=…&amp;role=ic"><div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-(--ink-muted)"><span>Flow</span><span class="text-(--accent-2)">Open</span></div><p class="mt-2 text-sm font-semibold text-foreground">Idea to merge insight.</p><p class="mt-2 text-xs text-(--ink-muted)">Review latency, throughput, WIP.</p></a><a class="group rounded-2xl border border-(--card-stroke) bg-(--card) px-4 py-3 transition hover:-translate-y-1" href="/metrics?tab=throughput&amp;f=…&amp;role=ic"><div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-(--ink-muted)"><span>Throughput</span><span class="text-(--accent-2)">Open</span></div><p class="mt-2 text-sm font-semibold text-foreground">Delivery volume and pacing.</p><p class="mt-2 text-xs text-(--ink-muted)">Throughput, WIP saturation, blocked work.</p></a><a class="group rounded-2xl border border-(--card-stroke) bg-(--card) px-4 py-3 transition hover:-translate-y-1" href="/metrics?tab=dora&amp;f=…&amp;role=ic"><div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-(--ink-muted)"><span>DORA</span><span class="text-(--accent-2)">Open</span></div><p class="mt-2 text-sm font-semibold text-foreground">Release