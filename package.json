{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/write-runtime-config.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/write-runtime-config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:unit": "vitest run",
    "test:integration": "node -e \"console.log('Integration tests are not implemented yet (placeholder).')\"",
    "test:ci": "bash ci/run_tests.sh ci"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.47.0",
    "@urql/core": "^6.0.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "graphql": "^16.10.0",
    "ioredis": "^5.10.0",
    "next": "^16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "urql": "^5.0.1",
    "web-vitals": "^5.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3",
    "@graphql-codegen/plugin-helpers": "6.2.1"
  },
  "pnpm": {
    "overrides": {
      "@graphql-codegen/plugin-helpers": "6.2.1"
    }
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@mswjs/http-middleware": "^0.10.3",
    "@next/eslint-plugin-next": "^16.2.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.2.0",
    "eslint-config-next": "16.2.2",
    "express": "^5.2.1",
    "jsdom": "^29.0.2",
    "lightningcss": "^1.31.1",
    "msw": "^2.13.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.3"
  }
}
