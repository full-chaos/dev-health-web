{
    "name": "webapp",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.1.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prepare": "lefthook install || true",
        "predev": "node scripts/write-runtime-config.mjs",
        "dev": "next dev",
        "build": "next build",
        "prestart": "node scripts/write-runtime-config.mjs",
        "start": "next start",
        "lint": "eslint src",
        "design-lint": "sh -c 'DESIGN_LINT=true pnpm exec eslint src; eslint_status=$?; node scripts/design-lint.mjs; scan_status=$?; exit $((eslint_status || scan_status))'",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:check:changed": "node scripts/check-format-changed.mjs",
        "typecheck": "tsc --noEmit",
        "codegen": "graphql-codegen --config codegen.ts",
        "codegen:check": "graphql-codegen --config codegen.ts --check",
        "test:e2e": "playwright test",
        "test:e2e:live": "playwright test -c playwright.live.config.ts",
        "test:unit": "vitest run",
        "test:integration": "node -e \"console.log('Integration tests are not implemented yet (placeholder).')\"",
        "test:ci": "bash ci/run_tests.sh ci"
    },
    "dependencies": {
        "@sentry/nextjs": "^10",
        "@tailwindcss/typography": "^0.5.20",
        "@urql/core": "^6",
        "@urql/next": "^2",
        "echarts": "^6",
        "echarts-for-react": "^3.0.6",
        "graphql": "^17",
        "ioredis": "^5.11.1",
        "next": "^16",
        "next-auth": "^5.0.0-beta.31",
        "pino": "^10",
        "pino-pretty": "^13",
        "react": "^19",
        "react-dom": "19",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "sonner": "^2",
        "urql": "^5",
        "web-vitals": "^5",
        "zod": "^4"
    },
    "overrides": {
        "serialize-javascript": ">=7.0.3",
        "@graphql-codegen/plugin-helpers": "6.2.1",
        "size-sensor": "npm:noop2@2.0.0"
    },
    "pnpm": {
        "overrides": {
            "serialize-javascript": ">=7.0.3",
            "@graphql-codegen/plugin-helpers": "6.2.1"
        }
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.1.2",
        "@graphql-codegen/client-preset": "^6.0.1",
        "@graphql-codegen/typescript": "^6.0.2",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@mswjs/http-middleware": "^0.10.3",
        "@next/eslint-plugin-next": "^16.2.9",
        "@playwright/test": "^1.61.0",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16",
        "@testing-library/user-event": "^14.6.1",
        "@types/express": "^5.0.6",
        "@types/node": "^25",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^10",
        "eslint-config-next": "^16",
        "eslint-config-prettier": "^10.1.8",
        "express": "^5.2.1",
        "jsdom": "^29.1.1",
        "lefthook": "^2.1.9",
        "lightningcss": "^1",
        "msw": "^2.14.6",
        "prettier": "^3.8.4",
        "tailwindcss": "^4",
        "typescript": "^6",
        "vitest": "^4.1.9"
    }
}
